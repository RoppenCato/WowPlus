# Installed tools (MySQL, CMake, Boost, OpenSSL): re-download instead of backing up
/Tools/
# Live database files and local database backups (contain account data)
/Database/
/Backups/
# Compiled server (binaries, deployed configs, logs): rebuilt by Build-Server.bat
/Build/
# Map data extracted from the game client (dbc, maps, vmaps, mmaps): large, and not ours to redistribute
/Data/
# The game client and its downloads: large, and not ours to redistribute.
# Everything in Client/ is ignored except our own two files.
/Client/*
!/Client/README.md
!/Client/realmlist.wtf
!/Client/Copy-Settings.bat
!/Client/Copy-Settings.ps1
!/Client/AddOns/
# Real passwords live here; Settings/.env.example is the committed template
/Settings/.env

# Files made for sending to someone (Settings/Scripts/Make-Features-Share.py); rebuilt from docs/ at any time
/Share/

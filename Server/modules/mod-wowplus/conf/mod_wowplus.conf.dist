#
# WowPlus: our own changes to the game.
#
# These are the defaults. To change one, copy the line to Settings/mod_wowplus.conf,
# change the value there and restart the server. Do not edit this file.
#

[worldserver]

########################################
# Extra loot
########################################
#
#    WowPlus.Loot.Enable
#        Every kill and every treasure chest has an extra chance at equipment for the
#        player's level, on top of the game's own loot. Enemies and areas that are
#        "grey" to the player (too low to give experience) give nothing.
#        Alone, the item lies in the corpse or chest. In a group it goes straight into
#        the human player's bags, so bots have nothing to roll on.
#        Default: 1

WowPlus.Loot.Enable = 1

#
#    WowPlus.Loot.Chance.*
#        Chance in percent that a kill (or an opened chest) gives one extra item.
#        Normal: ordinary enemies. Elite: elite enemies, which includes most enemies in
#        dungeons and raids. Rare: rare spawns. Boss: dungeon, raid and world bosses.
#        Default: 6, 20, 60, 100, 35

WowPlus.Loot.Chance.Normal = 6
WowPlus.Loot.Chance.Elite  = 20
WowPlus.Loot.Chance.Rare   = 60
WowPlus.Loot.Chance.Boss   = 100
WowPlus.Loot.Chance.Chest  = 35

#
#    WowPlus.Loot.Weight.*
#        How likely each rarity is when an item drops. Only the proportions matter.
#        With the defaults about 92 of 100 drops are green, 6 blue, 2 epic, and
#        1 in 1000 legendary.
#        Default: 92, 6, 1.9, 0.1

WowPlus.Loot.Weight.Uncommon  = 92
WowPlus.Loot.Weight.Rare      = 6
WowPlus.Loot.Weight.Epic      = 1.9
WowPlus.Loot.Weight.Legendary = 0.1

#
#    WowPlus.Loot.RarityRolls.*
#        Better enemies roll the rarity several times and keep the best result.
#        1 means a single roll. This is what makes bosses drop more blues and epics.
#        Default: 1, 2, 3, 4, 2

WowPlus.Loot.RarityRolls.Normal = 1
WowPlus.Loot.RarityRolls.Elite  = 2
WowPlus.Loot.RarityRolls.Rare   = 3
WowPlus.Loot.RarityRolls.Boss   = 4
WowPlus.Loot.RarityRolls.Chest  = 2

#
#    WowPlus.Loot.LevelWindow
#        Items can require the player's level, or up to this many levels more.
#        With 3, a level 10 character finds items for level 10 to 13.
#        Default: 3

WowPlus.Loot.LevelWindow = 3

#
#    WowPlus.Loot.UsableBias
#        Percent of drops that are picked from what the player's class can use: the
#        right armour type, a weapon the character has the skill for. The rest can be
#        anything. 0 = completely random, 100 = always usable when possible.
#        Default: 70

WowPlus.Loot.UsableBias = 70

#
#    WowPlus.Loot.LookAhead.Levels
#    WowPlus.Loot.LookAhead.MaxChance
#        In the last levels before 60, 70 and 80, a drop can be an item for that level
#        instead. The chance starts near zero and rises steeply: MaxChance is the
#        percent of drops at one level below the cap.
#        Default: 10, 25

WowPlus.Loot.LookAhead.Levels    = 10
WowPlus.Loot.LookAhead.MaxChance = 25

#
#    WowPlus.Loot.Cap.*
#        All gear for level 60 (and 70, and 80) requires the same level and differs by
#        item level: dungeon gear lowest, each raid higher. So at those levels a drop
#        follows the average item level of what the player is wearing.
#
#        Floor.60 / .70 / .80: item level of the first dungeon gear at that level. A
#            character in worse gear than this is treated as wearing this.
#        Step:  a drop can be up to this many item levels above the player's gear.
#        Below: and at most this many below it.
#        JumpChance: percent of drops that may reach further up, Step x JumpFactor.
#        Default: 58, 105, 174, 12, 10, 5, 2.5

WowPlus.Loot.Cap.Floor.60   = 58
WowPlus.Loot.Cap.Floor.70   = 105
WowPlus.Loot.Cap.Floor.80   = 174
WowPlus.Loot.Cap.Step       = 12
WowPlus.Loot.Cap.Below      = 10
WowPlus.Loot.Cap.JumpChance = 5
WowPlus.Loot.Cap.JumpFactor = 2.5

#
#    WowPlus.Loot.Mount.Chance
#    WowPlus.Loot.Pet.Chance
#        Flat chance in percent, per kill or chest, at a mount and at a companion pet.
#        Rolled separately from the equipment and the same for every enemy. A mount only
#        drops once the player is high enough to ride it. 0.1 is one in a thousand.
#        Default: 0.1, 0.2

WowPlus.Loot.Mount.Chance = 0.1
WowPlus.Loot.Pet.Chance   = 0.2

#
#    WowPlus.Loot.Collectibles.SkipKnown
#        1: never drop a mount or pet the character already has.
#        Default: 1

WowPlus.Loot.Collectibles.SkipKnown = 1

########################################
# Travel
########################################
#
#    WowPlus.Travel.Hearthstone.NoCooldown
#        1: the hearthstone can be used again at once. 0: the game's normal 30 minutes.
#        Default: 1

WowPlus.Travel.Hearthstone.NoCooldown = 1

#
#    WowPlus.Travel.Hearthstone.Menu
#        1: using the hearthstone opens a menu with Home and every city, hub town, dungeon
#        and raid the character has been to. A place unlocks on the first visit; travel is
#        free. Until a character has unlocked something the hearthstone works as usual.
#        Needs EnablePlayerSettings = 1 in worldserver.conf, or nothing is remembered.
#        Default: 1

WowPlus.Travel.Hearthstone.Menu = 1

########################################
# Random bonuses on equipment
########################################
#
#    WowPlus.Bonus.Enable
#        Looted, crafted and quest-reward weapons and armour can come with random bonuses.
#        Default: 1

WowPlus.Bonus.Enable = 1

#
#    WowPlus.Bonus.OnLoot / OnCraft / OnQuestReward
#        Where bonuses can appear.
#        Default: 1, 1, 1

WowPlus.Bonus.OnLoot        = 1
WowPlus.Bonus.OnCraft       = 1
WowPlus.Bonus.OnQuestReward = 1

#
#    WowPlus.Bonus.CraftedGuaranteed
#        1: crafted equipment always gets its first bonus. This is what makes crafting
#        the reliable way to gear next to drops.
#        Default: 1

WowPlus.Bonus.CraftedGuaranteed = 1

#
#    WowPlus.Bonus.Chance1 / Chance2 / Chance3
#        Chance in percent for a first, second and third bonus. Each one is only rolled
#        if the one before succeeded. With 35, 40, 40: about 1 item in 3 gets a bonus,
#        1 in 7 gets two (if its colour allows), 1 in 18 gets three.
#        Default: 35, 40, 40

WowPlus.Bonus.Chance1 = 35
WowPlus.Bonus.Chance2 = 40
WowPlus.Bonus.Chance3 = 40

#
#    WowPlus.Bonus.MaxCount.*
#        The most bonuses an item of each colour can have (0 to 3).
#        Default: 1, 2, 3, 3

WowPlus.Bonus.MaxCount.Uncommon  = 1
WowPlus.Bonus.MaxCount.Rare      = 2
WowPlus.Bonus.MaxCount.Epic      = 3
WowPlus.Bonus.MaxCount.Legendary = 3

#
#    WowPlus.Bonus.TierItemLevels
#        There are five strengths of bonus; a typical one gives about +6, +8, +15, +22 and
#        +29 to a stat. The item's level decides the strength: the weakest below the first
#        number, the next from there, and so on. Four numbers, separated by spaces.
#        Default: "30 70 115 200"
#            below item level 30: tier 1; 30 to 69: tier 2 (levelling up to about 60);
#            70 to 114: tier 3 (level 60 raids, Outland); 115 to 199: tier 4 (level 70,
#            Northrend); 200 and above: tier 5 (level 80 heroics and raids).

WowPlus.Bonus.TierItemLevels = "30 70 115 200"

#
#    WowPlus.Bonus.TierShift.*
#        The colour moves the strength up or down by whole tiers. With -1 a green gets
#        the tier below what its level says.
#        Default: -1, 0, 0, 1

WowPlus.Bonus.TierShift.Uncommon  = -1
WowPlus.Bonus.TierShift.Rare      = 0
WowPlus.Bonus.TierShift.Epic      = 0
WowPlus.Bonus.TierShift.Legendary = 1

#
#    WowPlus.Bonus.Slots
#        Technical: which three of the item's enchantment slots hold the bonuses.
#        "0 1 5" are the permanent enchant, the temporary enchant and the socket bonus
#        slot, known to show in the tooltip. Enchanting such an item replaces its first
#        bonus. "7 8 9" would be the slots of "of the Bear" style suffixes; untested.
#        Default: "0 1 5"

WowPlus.Bonus.Slots = "0 1 5"

#
#    WowPlus.Bonus.Announce
#        1: a chat line tells you when an item came with bonuses.
#        Default: 1

WowPlus.Bonus.Announce = 1

########################################
# Professions
########################################
#
#    WowPlus.Professions.GatherMultiplier
#        Herbs, ore, skinning and fishing give this many times the normal amount.
#        1 = as in the game.
#        Default: 3

WowPlus.Professions.GatherMultiplier = 3

########################################
# Finding problems
########################################
#
#    WowPlus.Loot.Debug
#        1: every kill and chest writes a line to the server log (logs/Server.log) saying what
#        the extra loot rule decided and why. For finding out why nothing drops. Leave at 0
#        otherwise: with many bots it fills the log.
#        Default: 0

WowPlus.Loot.Debug = 0

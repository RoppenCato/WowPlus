#
# WowPlus: our own changes to the game.
#
# These are the defaults. To change one, copy the line to Settings/mod_wowplus.conf,
# change the value there and restart the server. Do not edit this file.
#

[worldserver]

########################################
# Extra loot
########################################
#
#    WowPlus.Loot.Enable
#        Every kill and every treasure chest has an extra chance at equipment for the
#        player's level, on top of the game's own loot. Enemies and areas that are
#        "grey" to the player (too low to give experience) give nothing.
#        Alone, the item lies in the corpse or chest. In a group it goes straight into
#        the human player's bags, so bots have nothing to roll on.
#        Default: 1

WowPlus.Loot.Enable = 1

#
#    WowPlus.Loot.Chance.*
#        Chance in percent that a kill (or an opened chest) gives one extra item.
#        Normal: ordinary enemies. Elite: elite enemies, which includes most enemies in
#        dungeons and raids. Rare: rare spawns. Boss: dungeon, raid and world bosses.
#        Default: 6, 20, 60, 100, 35

WowPlus.Loot.Chance.Normal = 6
WowPlus.Loot.Chance.Elite  = 20
WowPlus.Loot.Chance.Rare   = 60
WowPlus.Loot.Chance.Boss   = 100
WowPlus.Loot.Chance.Chest  = 35

#
#    WowPlus.Loot.Weight.*
#        How likely each rarity is when an item drops. Only the proportions matter.
#        With the defaults about 92 of 100 drops are green, 6 blue, 2 epic, and
#        1 in 1000 legendary.
#        Default: 92, 6, 1.9, 0.1

WowPlus.Loot.Weight.Uncommon  = 92
WowPlus.Loot.Weight.Rare      = 6
WowPlus.Loot.Weight.Epic      = 1.9
WowPlus.Loot.Weight.Legendary = 0.1

#
#    WowPlus.Loot.RarityRolls.*
#        Better enemies roll the rarity several times and keep the best result.
#        1 means a single roll. This is what makes bosses drop more blues and epics.
#        Default: 1, 2, 3, 4, 2

WowPlus.Loot.RarityRolls.Normal = 1
WowPlus.Loot.RarityRolls.Elite  = 2
WowPlus.Loot.RarityRolls.Rare   = 3
WowPlus.Loot.RarityRolls.Boss   = 4
WowPlus.Loot.RarityRolls.Chest  = 2

#
#    WowPlus.Loot.LevelWindow
#        Items can require the player's level, or up to this many levels more.
#        With 3, a level 10 character finds items for level 10 to 13.
#        Default: 3

WowPlus.Loot.LevelWindow = 3

#
#    WowPlus.Loot.UsableBias
#        Percent of drops that are picked from what the player's class can use: the
#        right armour type, a weapon the character has the skill for. The rest can be
#        anything. 0 = completely random, 100 = always usable when possible.
#        Default: 70

WowPlus.Loot.UsableBias = 70

#
#    WowPlus.Loot.LookAhead.Levels
#    WowPlus.Loot.LookAhead.MaxChance
#        In the last levels before 60, 70 and 80, a drop can be an item for that level
#        instead. The chance starts near zero and rises steeply: MaxChance is the
#        percent of drops at one level below the cap.
#        Default: 10, 25

WowPlus.Loot.LookAhead.Levels    = 10
WowPlus.Loot.LookAhead.MaxChance = 25

#
#    WowPlus.Loot.Cap.*
#        All gear for level 60 (and 70, and 80) requires the same level and differs by
#        item level: dungeon gear lowest, each raid higher. So at those levels a drop
#        follows the average item level of what the player is wearing.
#
#        Floor.60 / .70 / .80: item level of the first dungeon gear at that level. A
#            character in worse gear than this is treated as wearing this.
#        Step:  a drop can be up to this many item levels above the player's gear.
#        Below: and at most this many below it.
#        JumpChance: percent of drops that may reach further up, Step x JumpFactor.
#        Default: 58, 105, 174, 12, 10, 5, 2.5

WowPlus.Loot.Cap.Floor.60   = 58
WowPlus.Loot.Cap.Floor.70   = 105
WowPlus.Loot.Cap.Floor.80   = 174
WowPlus.Loot.Cap.Step       = 12
WowPlus.Loot.Cap.Below      = 10
WowPlus.Loot.Cap.JumpChance = 5
WowPlus.Loot.Cap.JumpFactor = 2.5

#
#    WowPlus.Loot.Mount.Chance
#    WowPlus.Loot.Pet.Chance
#        Flat chance in percent, per kill or chest, at a mount and at a companion pet.
#        Rolled separately from the equipment and the same for every enemy. A mount only
#        drops once the player is high enough to ride it. 0.1 is one in a thousand.
#        Default: 0.1, 0.2

WowPlus.Loot.Mount.Chance = 0.1
WowPlus.Loot.Pet.Chance   = 0.2

#
#    WowPlus.Loot.Collectibles.SkipKnown
#        1: never drop a mount or pet the character already has.
#        Default: 1

WowPlus.Loot.Collectibles.SkipKnown = 1

########################################
# Travel
########################################
#
#    WowPlus.Travel.Hearthstone.NoCooldown
#        1: the hearthstone can be used again at once. 0: the game's normal 30 minutes.
#        Default: 1

WowPlus.Travel.Hearthstone.NoCooldown = 1

#
#    WowPlus.Travel.Hearthstone.Menu
#        1: using the hearthstone opens a menu with Home and every city, hub town, dungeon
#        and raid the character has been to. A place unlocks on the first visit; travel is
#        free. Until a character has unlocked something the hearthstone works as usual.
#        Needs EnablePlayerSettings = 1 in worldserver.conf, or nothing is remembered.
#        Default: 1

WowPlus.Travel.Hearthstone.Menu = 1

########################################
# Random bonuses on equipment
########################################
#
#    WowPlus.Bonus.Enable
#        Looted, crafted and quest-reward weapons and armour can come with random bonuses.
#        Default: 1

WowPlus.Bonus.Enable = 1

#
#    WowPlus.Bonus.OnLoot / OnCraft / OnQuestReward
#        Where bonuses can appear.
#        Default: 1, 1, 1

WowPlus.Bonus.OnLoot        = 1
WowPlus.Bonus.OnCraft       = 1
WowPlus.Bonus.OnQuestReward = 1

#
#    WowPlus.Bonus.CraftedGuaranteed
#        1: crafted equipment always gets its first bonus. This is what makes crafting
#        the reliable way to gear next to drops.
#        Default: 1

WowPlus.Bonus.CraftedGuaranteed = 1

#
#    WowPlus.Bonus.Chance1 / Chance2 / Chance3
#        Chance in percent for a first, second and third bonus. Each one is only rolled
#        if the one before succeeded. With 35, 40, 40: about 1 item in 3 gets a bonus,
#        1 in 7 gets two (if its colour allows), 1 in 18 gets three.
#        Default: 35, 40, 40

WowPlus.Bonus.Chance1 = 35
WowPlus.Bonus.Chance2 = 40
WowPlus.Bonus.Chance3 = 40

#
#    WowPlus.Bonus.MaxCount.*
#        The most bonuses an item of each colour can have (0 to 3).
#        Default: 1, 2, 3, 3

WowPlus.Bonus.MaxCount.Uncommon  = 1
WowPlus.Bonus.MaxCount.Rare      = 2
WowPlus.Bonus.MaxCount.Epic      = 3
WowPlus.Bonus.MaxCount.Legendary = 3

#
#    WowPlus.Bonus.TierItemLevels
#        There are five strengths of bonus; a typical one gives about +6, +8, +15, +22 and
#        +29 to a stat. The item's level decides the strength: the weakest below the first
#        number, the next from there, and so on. Four numbers, separated by spaces.
#        Default: "30 70 115 200"
#            below item level 30: tier 1; 30 to 69: tier 2 (levelling up to about 60);
#            70 to 114: tier 3 (level 60 raids, Outland); 115 to 199: tier 4 (level 70,
#            Northrend); 200 and above: tier 5 (level 80 heroics and raids).

WowPlus.Bonus.TierItemLevels = "30 70 115 200"

#
#    WowPlus.Bonus.TierShift.*
#        The colour moves the strength up or down by whole tiers. With -1 a green gets
#        the tier below what its level says.
#        Default: -1, 0, 0, 1

WowPlus.Bonus.TierShift.Uncommon  = -1
WowPlus.Bonus.TierShift.Rare      = 0
WowPlus.Bonus.TierShift.Epic      = 0
WowPlus.Bonus.TierShift.Legendary = 1

#
#    WowPlus.Bonus.Slots
#        Technical: which three of the item's enchantment slots hold the bonuses.
#        "0 1 5" are the permanent enchant, the temporary enchant and the socket bonus
#        slot, known to show in the tooltip. Enchanting such an item replaces its first
#        bonus. "7 8 9" would be the slots of "of the Bear" style suffixes; untested.
#        Default: "0 1 5"

WowPlus.Bonus.Slots = "0 1 5"

#
#    WowPlus.Bonus.Announce
#        1: a chat line tells you when an item came with bonuses.
#        Default: 1

WowPlus.Bonus.Announce = 1

########################################
# Professions
########################################
#
#    WowPlus.Professions.GatherMultiplier
#        Herbs, ore, skinning and fishing give this many times the normal amount.
#        1 = as in the game.
#        Default: 3

WowPlus.Professions.GatherMultiplier = 3

########################################
# Finding problems
########################################
#
#    WowPlus.Loot.Debug
#        1: every kill and chest writes a line to the server log (logs/Server.log) saying what
#        the extra loot rule decided and why. For finding out why nothing drops. Leave at 0
#        otherwise: with many bots it fills the log.
#        Default: 0

WowPlus.Loot.Debug = 0

########################################
# The hub
########################################
#
#    WowPlus.Hub.Enable
#        1: "The Hub" is in the hearthstone menu from the start. It is a small place on
#        GM Island with vendors for what a solo player cannot reasonably get alone.
#        The NPCs, what they sell and the prices are in Settings/SQL/world/..._hub.sql.
#        Default: 1

WowPlus.Hub.Enable = 1

#
#    WowPlus.Honor.FromKills
#    WowPlus.Honor.Normal / Elite / Rare / Boss
#        Enemies that are not grey to the player give honor, so that the PvP gear in the
#        hub is a slow reward for simply playing. The numbers are honor per kill by the
#        enemy's rank. For scale: a piece of level 80 PvP armour costs tens of thousands.
#        Default: 1, 10, 30, 60, 300

WowPlus.Honor.FromKills = 1
WowPlus.Honor.Normal    = 10
WowPlus.Honor.Elite     = 30
WowPlus.Honor.Rare      = 60
WowPlus.Honor.Boss      = 300

#
#    WowPlus.ArenaPoints.Normal / Elite / Rare / Boss
#        The same kills give arena points, for the arena gear in the hub. Fractions are
#        allowed: 0.2 means one point on about every fifth kill. For scale: an arena
#        weapon costs 3000 to 4700 points. Switched off together with WowPlus.Honor.FromKills.
#        Default: 0.2, 1, 3, 15

WowPlus.ArenaPoints.Normal = 0.2
WowPlus.ArenaPoints.Elite  = 1
WowPlus.ArenaPoints.Rare   = 3
WowPlus.ArenaPoints.Boss   = 15

#
#    WowPlus.Hub.NoRatingRequired
#        1: arena gear that asks for a personal arena rating can be bought without one.
#        The vendor window may still show the requirement in red; the purchase goes through.
#        Default: 1

WowPlus.Hub.NoRatingRequired = 1

########################################
# Classes
########################################
#
#    WowPlus.Classes.HunterStarterPet
#        1: a new hunter has a plain animal from their starting zone as a pet from level 1,
#        and knows how to call, dismiss, feed and revive it. Tame Beast still comes from
#        the trainer at level 10. The starter pet is given once; if it is abandoned it
#        does not come back.
#        Default: 1

WowPlus.Classes.HunterStarterPet = 1

#
#    WowPlus.Classes.ShamanTotemRelic
#        1: a shaman of level 4 or higher who does not have it gets the Totem of the
#        Earthen Ring, which replaces the four totem items the totem quests gave. The
#        totem spells themselves come from the trainer.
#        Default: 1

WowPlus.Classes.ShamanTotemRelic = 1

#
#    WowPlus.Classes.RogueDualWield
#        1: a rogue knows Dual Wield from level 1 (the game: level 10).
#        Default: 1

WowPlus.Classes.RogueDualWield = 1

#
#    WowPlus.Classes.RogueSecondDagger
#    WowPlus.Classes.CasterWand
#        Handing weapons out for free. Off: the weaponsmiths of the starting areas sell every
#        basic weapon, a second dagger and a first wand among them, so they are bought.
#        1 = a new rogue is given a second dagger / priests, mages and warlocks are given
#        a Lesser Magic Wand at level 5, each once.
#        Default: 0, 0

WowPlus.Classes.RogueSecondDagger = 0
WowPlus.Classes.CasterWand        = 0

########################################
# The world
########################################
#
#    WowPlus.World.Seed
#        The number that everything "random about the world" is worked out from: which
#        vendors have surprise stock and what, which theme a wandering merchant has.
#        The same seed is the same world. Change it for a different one.
#        Default: 1

WowPlus.World.Seed = 1

########################################
# Surprise stock on vendors
########################################
#
#    WowPlus.Vendors.Enable
#        1: the game's own vendors carry a little surprise stock, one of each item, for the
#        level of their zone. Not innkeepers, food and drink sellers or stable masters, and
#        not the vendors of the starting areas. Enabling this also raises the buy price of
#        dropped equipment, recipes, mounts and pets to something worth their being sold.
#        Default: 1

WowPlus.Vendors.Enable = 1

#
#    WowPlus.Vendors.PeriodDays
#        How long a stock holds. It is worked out from the seed and the period, so within a
#        period it is the same however often the server restarts. A vendor that is in view
#        when the period ends keeps its old shelf until the next restart.
#        Default: 7

WowPlus.Vendors.PeriodDays = 7

#
#    WowPlus.Vendors.Gear.GreenChance / BlueChance / EpicChance
#        For vendors who sell armour or weapons: the chance in percent that they have one
#        or two greens of the kind they sell, a blue, an epic. Each is rolled separately.
#        Default: 60, 12, 1

WowPlus.Vendors.Gear.GreenChance = 60
WowPlus.Vendors.Gear.BlueChance  = 12
WowPlus.Vendors.Gear.EpicChance  = 1

#
#    WowPlus.Vendors.Other.ConsumableChance / RecipeChance / GearChance
#        For the other speciality vendors (trade goods, reagents, supplies and so on): the
#        chance that they have a potion or elixir or two, a recipe, a single green.
#        Default: 15, 4, 8

WowPlus.Vendors.Other.ConsumableChance = 15
WowPlus.Vendors.Other.RecipeChance     = 4
WowPlus.Vendors.Other.GearChance       = 8

#
#    WowPlus.Vendors.MountChance / PetChance
#        For any of those vendors: the chance of a mount, of a companion pet.
#        0.25 is one vendor in 400.
#        Default: 0.25, 0.5

WowPlus.Vendors.MountChance = 0.25
WowPlus.Vendors.PetChance   = 0.5

#
#    WowPlus.Vendors.Wanderers
#        1: merchants who walk a route get a theme from the seed (beasts, mounts, potions,
#        armour, weapons, recipes, oddities) and a real stock of it, added to what they sold.
#        Default: 1

WowPlus.Vendors.Wanderers = 1

#
#    WowPlus.Vendors.PriceFactor
#        Prices of equipment are item level squared times a factor for the rarity (green 40,
#        blue 150, epic 600 copper), then times this number. 2 doubles every such price.
#    WowPlus.Vendors.MountPriceGold / PetPriceGold
#        The least a mount or pet costs, in gold. A mount costs this times 1, 2, 5 or 10
#        for the riding tier it needs (level 20, 40, 60, 70).
#        Default: 1, 800, 40

WowPlus.Vendors.PriceFactor    = 1
WowPlus.Vendors.MountPriceGold = 800
WowPlus.Vendors.PetPriceGold   = 40

########################################
# Bags from enemies
########################################
#
#    WowPlus.Loot.Bag.Chance
#        The small 6-slot pouches already drop in the starting zones. This carries the idea
#        on: enemies of level 10 to 17 can drop a plain 8-slot bag, 18 to 25 a 10-slot sack,
#        26 to 34 a 12-slot knapsack. Chance in percent per kill, not from grey enemies.
#        For comparison: the game's own pouches drop from about 80 kinds of enemy at 0.19.
#        Default: 0.5

WowPlus.Loot.Bag.Chance = 0.5

#
#    WowPlus.Vendors.Debug
#        1: every vendor that comes into view writes a line to logs/Server.log saying what
#        surprise stock it was given. This spoils the surprise: for finding problems only.
#        Default: 0

WowPlus.Vendors.Debug = 0

########################################
# Sprint on Shift
########################################
#
#    Hold Shift while running on foot or swimming for a short burst of speed, for as long as
#    stamina lasts. Short bursts pay off: stop before the bar is empty and it refills quickly;
#    run it empty and you are winded for a moment.
#    Needs the addon WowPlusSprint in the game (Client/AddOns, copied in by Start-Server.bat):
#    it tells the server that Shift is held and shows the stamina bar.
#    Sprint does nothing while mounted, in cat, travel, aquatic or ghost wolf form, in
#    stealth, or while another speed boost is active (Aspect of the Cheetah, rogue Sprint,
#    Dash and so on).
#
#    WowPlus.Sprint.Enable
#        Default: 1
#
#    WowPlus.Sprint.SpeedPercent
#        How much faster. 30 equals Aspect of the Cheetah and cat form at its peak, but sprint
#        is only on part of the time. A first mount is 60.
#        Default: 30
#
#    WowPlus.Sprint.Seconds
#        How long a full stamina bar lasts, out of combat.
#        Default: 6
#
#    WowPlus.Sprint.RefillSeconds
#        How long an empty bar takes to refill at normal speed.
#        Default: 8
#
#    WowPlus.Sprint.RefillDelay
#        Seconds after sprinting stops before the bar starts to refill.
#        Default: 1
#
#    WowPlus.Sprint.CombatDrain
#        In combat, stamina drains this many times faster. 1: no difference. 2: an escape,
#        not a way to outrun everything.
#        Default: 2
#
#    WowPlus.Sprint.RestartPercent
#        Winded: a bar that was run empty must refill this far before sprint works again
#        (the bar is red until then).
#        Default: 25
#
#    WowPlus.Sprint.Winded.RefillDelay
#        Seconds before a bar that was run empty starts to refill.
#        Default: 2
#
#    WowPlus.Sprint.Winded.RefillSpeed
#        Refill speed while winded, as a share of the normal speed. 1: no penalty.
#        Default: 0.75
#
#    WowPlus.Sprint.VisualKit
#        The effect shown at the feet while sprinting on land (a number from the game's
#        SpellVisualKit list). 10440: a small puff of dust. 1066: a bigger one.
#        12499: the swirl of the rogue's Sprint. 0: nothing.
#        Default: 10440
#
#    WowPlus.Sprint.VisualInterval
#        Seconds between two puffs.
#        Default: 0.7

WowPlus.Sprint.Enable             = 1
WowPlus.Sprint.SpeedPercent       = 30
WowPlus.Sprint.Seconds            = 6
WowPlus.Sprint.RefillSeconds      = 8
WowPlus.Sprint.RefillDelay        = 1
WowPlus.Sprint.CombatDrain        = 2
WowPlus.Sprint.RestartPercent     = 25
WowPlus.Sprint.Winded.RefillDelay = 2
WowPlus.Sprint.Winded.RefillSpeed = 0.75
WowPlus.Sprint.VisualKit          = 10440
WowPlus.Sprint.VisualInterval     = 0.7
